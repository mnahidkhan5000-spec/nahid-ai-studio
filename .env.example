# Server-only settings. Copy to .env on your own server; never commit real secrets.
# An image-capable Gemini API key with access to the selected model is required.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Required, at least 16 characters. A separate access code, NOT your Gemini key.
# Generate one: node -p "require('node:crypto').randomBytes(24).toString('hex')"
STUDIO_ACCESS_TOKEN=

HOST=0.0.0.0
PORT=3000
